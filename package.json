{
  "name": "sadovnikdiary3",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan --offline",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:lan": "expo start --web --host lan",
    "server": "node server/start-server.cjs",
    "test": "npm run test:unit",
    "test:unit": "node --require ./scripts/register-domain-tests.js tests/unit/runAll.unit.js",
    "lint": "eslint .",
    "export:web": "node scripts/export-web.js",
    "serve:dist": "node scripts/serve-dist.js",
    "phone:web": "node scripts/run-phone-web.js",
    "build:apk": "npx eas-cli build --platform android --profile apk",
    "check:expo": "npx expo-doctor",
    "pretest:e2e": "node scripts/clean-e2e-artifacts.js",
    "test:e2e": "node scripts/run-e2e.js",
    "test:e2e:allure": "npm run test:e2e && npm run allure:generate",
    "allure:open": "allure open allure-report",
    "allure:generate": "allure generate allure-results -o allure-report --clean",
    "demo:reports": "node scripts/generateDemoAdminReports.js",
    "generate:demo-reports": "node scripts/generateDemoAdminReports.js",
    "test:realistic-report": "node scripts/generateDemoAdminReports.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "expo": "~54.0.36",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.23",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech-recognition": "^3.1.3",
    "expo-status-bar": "~3.0.9",
    "jszip": "^3.10.1",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "xlsx": "^0.18.5"
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.60.0",
    "allure-commandline": "^2.42.1",
    "allure-playwright": "^3.10.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0"
  }
}
