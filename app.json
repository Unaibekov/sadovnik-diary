{
  "expo": {
    "name": "SadovnikDiary3",
    "slug": "SadovnikDiary3",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "com.sadovnikdiary3.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Sadovnik Diary to use Face ID for quick access"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Sadovnik Diary to use the camera"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Sadovnik Diary to access your photos"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Sadovnik Diary to use the microphone for voice input in AI Chat",
          "speechRecognitionPermission": "Allow Sadovnik Diary to convert your speech to text in AI Chat",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as"
          ]
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "aiBackendUrl": "http://localhost:8787",
      "guruModel": "qwen2.5-72b",
      "eas": {
        "projectId": "006e9c5e-f045-44b1-8f76-e48fc871dd67"
      }
    }
  }
}
